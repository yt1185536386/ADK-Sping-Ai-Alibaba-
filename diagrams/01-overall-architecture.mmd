    CHAT_CTRL --> HITL_SVC
    CHAT_CTRL --> CONV

    DLV_CTRL --> DLV_SVC
    DLV_SVC --> AMAP_SVC
    DLV_SVC --> ASSET_SVC
    WMS --> ASSET_SVC
    HR -. "离职事件" .-> EVT

# P0 安全改造环境变量配置
# 使用方法：复制本文件为 .env 并填入真实值，或直接在系统环境变量中设置

# ==================== 数据库配置 ====================
# 注意：DB_* 与 API_KEY_ENCRYPTION_KEY 由主应用（hr-agent :20810）与
# MCP Server（mcp-server/ :20811，承载天气/高德等外部工具）共同使用——
# 两个进程读同一个 external_tool 表、用同一把主密钥解密密钥。
# 数据库主机
DB_HOST=localhost
# 数据库端口
DB_PORT=3306
# 数据库名
DB_NAME=hr_spring_ai_adk_agent
# 专用账号（非 root）
DB_USERNAME=hr_agent
# 专用账号密码（必须强密码，与 init-db-user.sql 中设置的保持一致）
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
# 是否启用 SSL
DB_USE_SSL=false

# ==================== API Key 加密 ====================
# AES-256-GCM 主密钥（32 字节 Base64 编码）
# 生成方式：openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=CHANGE_THIS_TO_BASE64_ENCODED_32_BYTES

# ==================== 应用配置 ====================
# 主应用端口（mcp-server 固定 20811，前端 dev 5173）
SERVER_PORT=20810

# ==================== 初始管理员（仅首次启动、sys_user 为空时生效） ====================
# 首次启动时 AdminBootstrap 会创建管理员账号：
# - 配置下面两个变量则按指定值创建；
# - 不配置则随机生成 16 位密码，只在启动日志里打印一次（之后立即登录修改）。
# 数据库不可用时，同一个 ADMIN_INITIAL_PASSWORD 也作为内存应急账号（admin）的密码。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ==================== 外部工具密钥（可选，推荐直接入 external_tool 表） ====================
# 主路径是把密钥加密后写进 external_tool 表（用 ExternalToolService.saveApiKey(toolKey, key)）。
# 这里的环境变量仅在「临时本地调试、不想动数据库」时作兜底参考，代码默认不读。
# 高德 Web 服务 key 申请：https://lbs.amap.com
# AMAP_API_KEY=

# ==================== 说明 ====================
# 1. 本文件包含敏感信息，严禁提交到版本控制系统
# 2. .gitignore 中应添加 .env
# 3. 生产环境建议使用密钥管理服务（如 HashiCorp Vault、AWS KMS）
